# Seals the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-a-32-character-secret

# Absolute origin, used to build password-reset links.
NUXT_APP_URL=http://localhost:3000

# Set to false to hide the demo credentials hint on the sign-in page.
NUXT_PUBLIC_DEMO_MODE=true
