# Seals the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-a-32-character-secret

# Absolute origin. Used for password-reset links, verification links, og:image,
# canonical URLs, and the host in robots.txt and sitemap.xml.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# How email leaves the building.
#   console   → prints the message to the server log (default; no account needed)
#   resend    → https://resend.com,  set RESEND_API_KEY
#   postmark  → https://postmarkapp.com, set POSTMARK_TOKEN
# Leave it on `console` in development: the reset link and the two-step code are
# printed, so every auth flow is testable without an email account.
MAIL_DRIVER=console
MAIL_FROM=Cadence <onboarding@resend.dev>
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# POSTMARK_STREAM=outbound

# libsql connection string.
#   local file  → file:./.data/cadence.db   (prefer an absolute path in production)
#   Turso       → libsql://your-db.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./.data/cadence.db
# DATABASE_AUTH_TOKEN=

# Set to false to hide the demo credentials hint on the sign-in page.
NUXT_PUBLIC_DEMO_MODE=true
