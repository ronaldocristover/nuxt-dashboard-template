# Seals the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-a-32-character-secret

# Absolute origin. Used for password-reset links, verification links, and the
# host in robots.txt and sitemap.xml.
NUXT_APP_URL=http://localhost:3000

# libsql connection string.
#   local file  → file:./.data/cadence.db   (prefer an absolute path in production)
#   Turso       → libsql://your-db.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./.data/cadence.db
# DATABASE_AUTH_TOKEN=

# Set to false to hide the demo credentials hint on the sign-in page.
NUXT_PUBLIC_DEMO_MODE=true
