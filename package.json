{
  "name": "cadence-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cadence — a production-ready Nuxt 4 + Tailwind CSS dashboard template with authentication, analytics, and settings.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "i18n:check": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run i18n:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p .data && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/database/seed.ts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.0",
    "@internationalized/date": "^3.12.3",
    "@libsql/client": "^0.17.4",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
